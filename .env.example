APP_NAME=Xspann
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=spark
# DB_USERNAME=root
# DB_PASSWORD=

# Cache & Queue driver (supported: "sqlite", "redis")
CACHE_DRIVER=sqlite
QUEUE_DRIVER=sqlite

# Shared Redis connection config (used by Cache, Queue, and Lock)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0
REDIS_PREFIX=spark
REDIS_TIMEOUT=0.0
REDIS_READ_TIMEOUT=0.0
REDIS_PERSISTENT=false

# Filesystem: local -> private, public -> uploads, s3
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com
# AWS_URL=

# Mail & SMTP configuration
MAIL_SMTP=false
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API and video processing
VIDEO_UPLOAD_MODE=local
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=

# Comma-separated Android/iOS OAuth client IDs; GOOGLE_CLIENT_ID remains the Web client.
GOOGLE_ALLOWED_PRESENTER_IDS=
API_TOKEN_EXPIRATION=43200

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

