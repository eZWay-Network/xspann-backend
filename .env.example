APP_NAME="XPN Social"
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=spark
# DB_USERNAME=root
# DB_PASSWORD=

# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Session, Cache and Queue driver (supported: "database", "redis" and "file")
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Shared Redis connection config (used by Cache, Queue, and Lock)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0
REDIS_PREFIX=spark
REDIS_TIMEOUT=0.0
REDIS_READ_TIMEOUT=0.0
REDIS_PERSISTENT=false

# Filesystem: local -> private, public -> uploads, s3
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com
# AWS_URL=

# Mail Transport: mail, sendmail, smtp, log
MAIL_TRANSPORT=smtp

# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# API and video processing
VIDEO_UPLOAD_MODE=local
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=

# Comma-separated Android/iOS OAuth client IDs; GOOGLE_CLIENT_ID remains the Web client.
GOOGLE_ALLOWED_PRESENTER_IDS=
API_TOKEN_EXPIRATION=43200

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe


VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_RELAY_APP_KEY=

# Private drafts must never use the public disk. For multi-host deployments choose a private S3 disk.
RELEASE_FILESYSTEM_DISK=local

# Stripe HTTP integration; APP_DEBUG must be false. Live sales remain disabled in config/billing.php.
BILLING_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Comma-separated signing secrets permit rotation. Snapshot webhook API version: 2024-06-20.
STRIPE_WEBHOOK_SECRETS=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_AUTOMATIC_TAX=false
BILLING_RETURN_URL=http://localhost:3000/billing/success
BILLING_CANCEL_URL=http://localhost:3000/billing/cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing

# Relay: backend publishing stays private; browsers use only the public key and WSS address.
RELAY_APP_ID=1
RELAY_APP_KEY=
RELAY_APP_SECRET=
RELAY_ALLOWED_ORIGIN=http://localhost:3000
RELAY_SERVER_HOST=127.0.0.1
RELAY_SERVER_PORT=8081
RELAY_HOST=127.0.0.1
RELAY_PORT=8081
RELAY_SCHEME=http
RELAY_PUBLIC_HOST=localhost
RELAY_PUBLIC_PORT=8081
RELAY_PUBLIC_TLS=false
