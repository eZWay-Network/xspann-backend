{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"resources/app/**/*.{ts,tsx}\" resources/app/app.css",
    "format": "prettier --write \"resources/app/**/*.{ts,tsx}\" resources/app/app.css",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@inertiajs/react": "3.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.0.7",
    "typescript": "5.9.3",
    "vite": "^7.1.4",
    "vite-plugin-full-reload": "^1.2.0"
  }
}
